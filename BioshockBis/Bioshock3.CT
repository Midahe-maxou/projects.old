        <CheatEntry>
          <ID>11</ID>
          <Description>"Infinite ammo"</Description>
          <Color>000080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

// Decrease total rounds.
"Bioshock.exe"+378996:
nop 3

// Decrease ammo in clip.
"Bioshock.exe"+3DCB0C:
nop 2

 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
"Bioshock.exe"+378996:
db 29 48 4C // sub [eax+4C],ecx

"Bioshock.exe"+3DCB0C:
db 29 07 // sub [edi], eax
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>10</ID>
          <Description>"God mod"</Description>
          <Color>000080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
//place your code here


cmp [esi+D4],0
jne originalcode
movaps xmm1, xmm2


originalcode:
movss [esi+00000540],xmm1

exit:
jmp returnhere

"Bioshock.exe"+350175:
jmp newmem
nop 3
returnhere:


 
 
[DISABLE]
//code from here till the end of the code will be used to disable the cheat
dealloc(newmem)
"Bioshock.exe"+350175:
db F3 0F 11 8E 40 05 00 00
//movss [esi+00000540],xmm1
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>56</ID>
          <Description>"One shot"</Description>
          <Color>000080</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat
alloc(newmem,2048)
label(returnhere)
label(originalcode)
label(exit)

newmem: //this is allocated memory, you have read,write,execute access
